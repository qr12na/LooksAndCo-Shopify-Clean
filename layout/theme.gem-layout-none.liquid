{% comment %}
	GEMPAGES BUILDER (https://apps.shopify.com/gempages)

	You SHOULD NOT modify source code in this file because
	It is automatically generated from GEMPAGES BUILDER
	Try to edit page with the live editor.
{% endcomment %}
<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    <style>
      body.looksco-home {
        background: radial-gradient(circle at 12% 8%, rgb(232 220 201 / 48%), transparent 26rem), linear-gradient(180deg, #fbfaf8 0%, #f4f1ec 100%);
      }
      body.looksco-home .hero-wrapper {
        margin: 16px clamp(12px, 2vw, 30px) 28px;
        overflow: hidden;
        border: 1px solid rgb(255 255 255 / 55%);
        border-radius: clamp(22px, 3vw, 34px);
        box-shadow: 0 22px 60px rgb(42 34 23 / 16%), inset 0 1px 0 rgb(255 255 255 / 35%);
      }
      body.looksco-home .hero-wrapper .hero { min-height: clamp(480px, 62vw, 720px); }
      body.looksco-home .hero-wrapper img { transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1); }
      body.looksco-home .hero-wrapper:hover img { transform: scale(1.025); }
      body.looksco-home .hero-wrapper :is(h1, h2, h3) { max-width: 12ch; letter-spacing: -0.045em; text-wrap: balance; text-shadow: 0 4px 28px rgb(0 0 0 / 30%); }
      body.looksco-home .ui-test-product-list {
        max-width: 1480px;
        margin: 0 auto clamp(28px, 5vw, 70px);
        padding: clamp(24px, 4vw, 56px);
        border: 1px solid rgb(255 255 255 / 70%);
        border-radius: clamp(24px, 3vw, 36px);
        background: linear-gradient(135deg, rgb(255 255 255 / 82%), rgb(247 243 237 / 90%)), rgb(247 243 237);
        box-shadow: 0 18px 48px rgb(41 31 18 / 10%), inset 0 1px 0 #fff;
      }
      body.looksco-home .ui-test-product-list :is(h1, h2, h3) { margin-bottom: clamp(20px, 3vw, 34px); letter-spacing: -0.04em; }
      body.looksco-home .product-card {
        overflow: hidden;
        border: 1px solid rgb(78 62 42 / 12%);
        border-radius: 22px;
        background: rgb(255 255 255 / 78%);
        box-shadow: 0 10px 24px rgb(39 27 12 / 8%), inset 0 1px 0 rgb(255 255 255 / 86%);
        transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 280ms ease, border-color 280ms ease;
        animation: looksco-rise 520ms both;
      }
      body.looksco-home .product-card:hover { transform: translateY(-7px); border-color: rgb(117 91 59 / 28%); box-shadow: 0 20px 34px rgb(39 27 12 / 16%), inset 0 1px 0 #fff; }
      body.looksco-home .product-card:nth-child(2) { animation-delay: 80ms; }
      body.looksco-home .product-card:nth-child(3) { animation-delay: 160ms; }
      body.looksco-home .product-card:nth-child(4) { animation-delay: 240ms; }
      body.looksco-home .product-card :is(.card-gallery, .product-card__link, img) { border-radius: 18px; }
      body.looksco-home .product-card img { transition: transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1); }
      body.looksco-home .product-card:hover img { transform: scale(1.045); }
      body.looksco-home :is(.badge, .product-card__badge, [class*='badge']) { border: 1px solid rgb(255 255 255 / 70%); border-radius: 999px; box-shadow: 0 4px 12px rgb(0 0 0 / 10%); }
      body.looksco-home :is(.button, .button-custom, .button-secondary) {
        border-radius: 14px;
        transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 200ms ease, background-color 200ms ease, border-color 200ms ease;
      }
      body.looksco-home :is(.button, .button-custom, .button-secondary):hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgb(0 0 0 / 17%); }
      body.looksco-home :is(.button, .button-custom, .button-secondary):active { transform: translateY(0) scale(0.98); }
      @keyframes looksco-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
      @media screen and (max-width: 749px) {
        body.looksco-home .hero-wrapper { margin: 8px 10px 20px; border-radius: 20px; }
        body.looksco-home .hero-wrapper .hero { min-height: 440px; }
        body.looksco-home .ui-test-product-list { margin-inline: 10px; padding: 20px; border-radius: 22px; }
        body.looksco-home .product-card { border-radius: 18px; }
      }
      @media (prefers-reduced-motion: reduce) {
        body.looksco-home *, body.looksco-home *::before, body.looksco-home *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }

      body.looksco-home .resource-list--grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 320px)) !important;
        justify-content: center;
        gap: clamp(18px, 2vw, 28px) !important;
      }

      body.looksco-home .resource-list__item {
        min-width: 0;
      }

      body.looksco-home .product-card .card-gallery {
        aspect-ratio: 4 / 5;
        overflow: hidden;
      }

      body.looksco-home .product-card .card-gallery :is(img, video) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      body.looksco-home .product-card .text-block {
        min-height: 4.15em;
        font-size: 0.98rem;
        line-height: 1.38;
        letter-spacing: -0.015em;
      }

      body.looksco-home .product-card .price {
        font-size: 1.35rem !important;
        font-weight: 750;
        letter-spacing: -0.035em;
      }

      body.looksco-home .product-card .compare-at-price {
        font-size: 1rem !important;
        opacity: 0.6;
      }

      body.looksco-home footer {
        max-width: 1480px;
        margin: 0 auto 22px;
        padding: clamp(20px, 3vw, 34px);
        border: 1px solid rgb(255 255 255 / 78%);
        border-radius: clamp(22px, 3vw, 32px);
        background: rgb(255 255 255 / 72%);
        box-shadow: 0 12px 34px rgb(41 31 18 / 8%), inset 0 1px 0 #fff;
      }

      @media screen and (min-width: 750px) {
        body.looksco-home .ui-test-product-list {
          width: min(calc(100% - 48px), 1480px) !important;
          max-width: none;
        }

        body.looksco-home .ui-test-product-list .section-resource-list {
          width: 100% !important;
          grid-template-columns: clamp(20px, 3vw, 48px) minmax(0, 1fr) clamp(20px, 3vw, 48px) !important;
        }

        body.looksco-home .resource-list--grid {
          grid-template-columns: repeat(2, minmax(280px, 360px)) !important;
          justify-content: center;
        }
      }

      @media screen and (max-width: 749px) {
        body.looksco-home .resource-list--grid {
          grid-template-columns: minmax(0, 1fr) !important;
        }
      }

      html {
        scroll-behavior: smooth;
      }

      ::selection {
        background: rgb(93 69 42 / 22%);
        color: #1d1710;
      }

      :focus-visible {
        outline: 2px solid #75542f;
        outline-offset: 3px;
      }

      .announcement-bar {
        letter-spacing: 0.01em;
      }

      #header-component .menu-list__link {
        position: relative;
        transition: color 180ms ease, opacity 180ms ease;
      }

      @media (hover: hover) {
        #header-component .menu-list__link:hover {
          opacity: 0.82;
        }

        .resource-card,
        .article-card {
          transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 240ms ease;
        }

        .resource-card:hover,
        .article-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 16px 30px rgb(39 27 12 / 12%);
        }
      }

      :is(input:not([type='checkbox']):not([type='radio']), textarea, select) {
        border-radius: 14px;
        transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
      }

      :is(input:not([type='checkbox']):not([type='radio']), textarea, select):focus {
        border-color: rgb(104 76 44 / 56%);
        box-shadow: 0 0 0 4px rgb(104 76 44 / 12%);
      }

      .button,
      .button-secondary,
      .button-unstyled {
        -webkit-tap-highlight-color: transparent;
      }

      main > .shopify-section {
        animation: looksco-section-in 420ms both;
      }

      main > .shopify-section:nth-child(2) {
        animation-delay: 70ms;
      }

      main > .shopify-section:nth-child(3) {
        animation-delay: 140ms;
      }

      @keyframes looksco-section-in {
        from {
          opacity: 0;
          translate: 0 12px;
        }

        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        main > .shopify-section {
          animation: none;
        }
      }

      @media screen and (min-width: 750px) {
        body.looksco-home .ui-test-product-list {
          width: calc(100% - 48px) !important;
          max-width: none !important;
        }

        body.looksco-home .ui-test-product-list .section-resource-list {
          width: 100% !important;
        }

        body.looksco-home .resource-list--grid {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
          width: 100%;
          justify-content: stretch;
        }

        body.looksco-home .resource-list__item,
        body.looksco-home .product-card {
          width: 100%;
        }

        body.looksco-home footer {
          width: calc(100% - 48px);
          max-width: none;
          box-sizing: border-box;
        }
      }

      @media screen and (min-width: 750px) {
        main[data-template='product'] .card-gallery {
          width: min(100%, 420px);
          height: clamp(340px, 38vw, 440px) !important;
          margin-inline: auto;
          border-radius: 24px;
          overflow: hidden;
          box-shadow: 0 14px 32px rgb(39 27 12 / 12%);
        }

        main[data-template='product'] :is(slideshow-component, slideshow-container, slideshow-slides, slideshow-slide, .product-media-container, .product-media) {
          height: 100% !important;
        }

        main[data-template='product'] .product-media :is(img, video) {
          width: 100%;
          height: 100%;
          object-fit: contain;
          background: #f6f3ef;
        }
      }
    </style>

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body>
<div class="gem-container">
	{{ content_for_layout }}
</div><!-- end .gem-container --></body>
</html>
